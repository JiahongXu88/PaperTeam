# ============================================================
# PaperTeam 环境变量示例
#
# 使用方法：复制本文件为 .env，填入真实值。
# .env 已被 .gitignore 忽略，严禁将真实 Key 提交到仓库。
# ============================================================

# ---- 服务 ----
# PaperTeam Backend 监听端口
PAPERTEAM_PORT=3000
# HTTP 监听地址（可选，默认 127.0.0.1 回环——单用户本地工具的保守默认）。
# Linux 服务器 / Docker 部署需显式 0.0.0.0（compose 已内置）；PaperTeam 无鉴权，
# 非回环绑定请配合 SSH tunnel / 私有网络 / 安全组白名单（见 docs/deployment/linux-server.md）
# PAPERTEAM_HOST=127.0.0.1
# 运行环境: development | production
NODE_ENV=development

# ---- Agent Runtime（Pi SDK in-process，M3.8 起唯一 Runtime） ----
# @earendil-works/pi-coding-agent 1.0.1 精确 pin（版本以 backend/package.json 为准）。
# 模型规格 "provider/model-id"（如 anthropic/claude-opus-4-5）。
# 也可在前端 Settings → Model 页面保存（本地用户推荐）；
# 优先级：下面的环境变量 > Settings UI 保存的本地配置。
# 未配置时 Pi Runtime 健康但 Agent 调用结构化失败（model not_configured）
# PAPERTEAM_PI_MODEL=anthropic/claude-opus-4-5
# Provider API Key（可选；也可在前端 Settings → Model 保存，不落仓库目录）。
# 不设置则按 Pi 官方优先级解析：
# <agentDir>/auth.json（Settings UI 保存位置）> 标准环境变量如 ANTHROPIC_API_KEY
# PAPERTEAM_PI_API_KEY=
# Pi 配置目录（可选，默认 <PAPERTEAM_RUNTIME_ROOT>/runtime/pi/agent）
# PAPERTEAM_PI_AGENT_DIR=
# Pi 单次 runAgent 的通用执行超时（毫秒，可选，默认 300000）：可行性评估 / PaperMap 摘要 /
# PDF 分析 / 引用核验 / Skill 简介等短任务的口径（Runtime 全局契约，不建议整体抬高）
# PAPERTEAM_PI_RUN_TIMEOUT_MS=300000
# 长论文阶段的执行超时（毫秒，可选，默认 900000 = 15 分钟；1s-1h）：Writer（章节写作 /
# 逐节修订 / 润色 / 改进计划 / 编译修复）、三路 Reviewer、分章节 Reviewer、Researcher
# 以整篇论文为输入的长任务。M5.6 真实 26 页论文验收实测：单节修订最长 626s、单路审稿
# 315s，通用 300s 会高频误超时；本值逐 run 覆盖（RunAgentInput.timeoutMs），不改 Runtime 默认
# PAPERTEAM_PI_LONG_RUN_TIMEOUT_MS=900000
# Runtime 全局最大同时执行数（M5.2，可选，默认 4；1-64）：整个后端同时
# 真实执行的 Agent run 上限（最后一道全局背压，跨项目/角色/工作流统一生效）
# PAPERTEAM_PI_MAX_CONCURRENT_RUNS=4
# Runtime 全局最大等待任务数（M5.2，可选，默认 32；0-1024，0=不允许等待）：
# 已受理未执行任务占满后，新任务立即结构化失败（RUNTIME_QUEUE_FULL）
# PAPERTEAM_PI_MAX_QUEUED_RUNS=32
# 单会话 run 数回转上限（M5.2，可选，默认 32；1-10000）：context usage
# 不可得/非实测（provider 不返回 usage）时的 session rotation 兜底
# PAPERTEAM_PI_MAX_RUNS_PER_SESSION=32
# 会话空闲 TTL（毫秒，M5.2，可选，默认 1800000=30 分钟；60s-24h）：
# 空闲会话（无在途/排队任务）超时后由 Runtime GC 回收（Workspace 不受影响）
# PAPERTEAM_PI_SESSION_IDLE_TTL_MS=1800000
# Runtime 受管会话数硬上限（M5.2，可选，默认 16；1-256）：达到上限先回收
# 空闲会话（TTL→LRU），全部忙则新任务立即结构化失败（RUNTIME_SESSION_CAPACITY）
# PAPERTEAM_PI_MAX_SESSIONS=16
# 输出预留 token 数（M5.2，可选，1024-262144；缺省按模型推导：
# min(model.maxTokens, ceil(contextWindow×25%), 32768)）：下次 prompt 前
# 为模型输出保留的空间；单次输入+预留超窗 → CONTEXT_BUDGET_EXCEEDED（不截断）
# PAPERTEAM_PI_OUTPUT_RESERVE_TOKENS=
# 用户级运行时根目录（可选，默认 ~/.paperteam；必须绝对路径）
# PAPERTEAM_RUNTIME_ROOT=
# 业务角色会话标识（可选，默认 main；仅作 sessionKey 组成段与诊断标签）
# PAPERTEAM_WRITER_AGENT_ID=main
# PAPERTEAM_RESEARCHER_AGENT_ID=main
# PAPERTEAM_REVIEWER_AGENT_ID=main
# PAPERTEAM_CITATION_AGENT_ID=main

# ---- Evaluation（M6.9.3 multi-model 公开名归一化） ----
# GLM-5.3 评估目标的网关路由模型 id。仓库与 evaluation 产物（报告/矩阵/文件名）
# 统一展示公开名 GLM-5.3；网关内部路由别名仅作为运行时参数经本变量注入实际
# API 调用（放本文件对应的 .env 或进程环境），不写入仓库与产物。
# 未设置时按公开名路由（网关侧可能按未知模型报错，由单模型失败协议如实记录）
# PAPERTEAM_EVAL_GLM53_GATEWAY_MODEL=

# ---- 部署 / 停机（M5.5） ----
# SIGTERM 后协作式收敛（停止受理 → 取消在途 run → checkpoint 落盘 → 释放会话）的最长等待，
# 超过即强制退出（毫秒，可选，默认 30000；1000-600000）。Docker 部署应小于 stop_grace_period
# PAPERTEAM_SHUTDOWN_TIMEOUT_MS=30000

# ---- Skills（M5.3） ----
# 禁用的 Skill id（逗号分隔，可选，默认无）：仍显示在 Skills 页但不注入任何会话；
# 用于 A/B 验收关闭学术 Skill，如 academic-writing-zh,academic-review,academic-style-zh
# PAPERTEAM_DISABLED_SKILLS=

# ---- Workflow（M3） ----
# 单个 Stage 的空闲超时（毫秒，可选，默认 900000）：连续这么久没有进度汇报即判超时；
# 分章节 Review 等长 stage 会按章节汇报进度，因此总时长可超过该值
# WORKFLOW_STAGE_TIMEOUT_MS=900000
# 单个 Stage 最大尝试次数（可选，默认 2）
# WORKFLOW_STAGE_MAX_ATTEMPTS=2
# 自动修订最大轮数（bounded loop，可选，默认 2；超出进入 HITL）
# WORKFLOW_MAX_REVISION_ROUNDS=2
# Quality Gate 阈值（可选；默认 academic>=80、style<=35）
# QUALITY_ACADEMIC_PASS_SCORE=80
# QUALITY_STYLE_RISK_MAX=35
# M13 Final Closure：academicScore 带内复核（主样本分数落在 [阈值-带宽, 阈值+带宽) 时追加 ≤N 份独立
# academic 采样取中位数；事实类 critical/major 并入、意见类须跨样本重现）。BAND=0 或 SAMPLES=0 关闭。
# QUALITY_ACADEMIC_CONFIRMATION_BAND=5
# QUALITY_ACADEMIC_CONFIRMATION_SAMPLES=2
# M14.9.1 任务级（跨 run / 跨进程）模型预算账本：一个外层任务的全部 improvement run、复审与外部脚本共享
# 同一文件账本；每次请求启动前预留「prompt 预估 + 输出上界」，超限拒绝启动并持久化 BUDGET_EXHAUSTED
# （上限只能收紧；路径必须是绝对路径；未设置 = 不启用）
# PAPERTEAM_GLOBAL_BUDGET_LEDGER=D:/PaperTeamData/<task>/global-budget-ledger.json
# PAPERTEAM_GLOBAL_MAX_MODEL_CALLS=110
# PAPERTEAM_GLOBAL_MAX_TOKENS=3500000
# PAPERTEAM_GLOBAL_OUTPUT_RESERVE_TOKENS=16000
# M14.9.1 实验开关（缺省关闭，未经独立 A/B 复核前不要用于正式评分）：
#   PAPERTEAM_REVIEW_INPUT_MODE=metadata_blind   digest 审稿视图按字段去掉作者 / 单位 / 邮箱 / 致谢 / 源码注释
#   PAPERTEAM_REVIEW_NEUTRALITY_POLICY=1          审稿 prompt 追加「元数据 / 投稿格式不计入学术评分」条款
# PAPERTEAM_REVIEW_INPUT_MODE=production
# PAPERTEAM_REVIEW_NEUTRALITY_POLICY=0
# M14.9.5.1 长文档单元审稿的上下文策略（缺省 shared_session = 历史行为，真实验收前不默认切换）：
#   shared_session            同一项目全部单元共用一个审稿会话；单元能看到哪些其他单元取决于调度顺序与超时后会话是否
#                             重建（不可复现；仅作回滚口径）
#   isolated_no_dependencies  每次尝试一个全新封闭会话（不可读工作区），不附跨单元依赖（归因对照用）
#   isolated_snapshot         每次尝试一个全新封闭会话 + 确定性 Review Context Snapshot：单元引用、但位于其他单元的
#                             表 / 图 / 公式按 \label/\ref 与唯一题注编号附上（歧义 / 找不到 / 超预算如实记为缺口）
# 旧开关 PAPERTEAM_REVIEW_UNIT_ISOLATION=1 等价 isolated_snapshot（同时设置时以 PAPERTEAM_REVIEW_UNIT_CONTEXT 为准）。
# PAPERTEAM_REVIEW_UNIT_CONTEXT=shared_session
# 单个单元附带的跨单元依赖原文上限（字符；整块附上或记 CONTEXT_OVERFLOW，不截断表格）
# PAPERTEAM_REVIEW_UNIT_DEPENDENCY_CHARS=12000
# M15.1 Review Claim Ledger（shadow 审计产物 reviews/claim-audit-r*.json / citation-audit-r*.json，生产 Gate 不读）：
#   auto（缺省）只读评估 = extended、作者稿件 = shadow；off 不产出；shadow 不改 prompt；extended 单元 prompt 追加论断账本契约
# PAPERTEAM_REVIEW_CLAIM_AUDIT=auto
# extended 模式每轮有界跨单元论断复核的模型调用上限（每次 ≤8 条论断；0 = 关闭）
# PAPERTEAM_REVIEW_CLAIM_RECHECK_CALLS=2

# ---- Target 面板（M15.16） ----
# 「证据审计（实验性）」feature flag：目标参照系面板的逐创新点先前工作比较入口
# （PAPERTEAM_TARGET_EVIDENCE_AUDIT_ENABLED，默认 false 不装配服务）。
# 开启后：GET /api/projects/:id/target/evidence-audit 返回 enabled:true；
# POST 执行 = 确定性构建先前工作池 + 3 次有界模型调用（advisory，只读，零 gate 接线）。
# 关闭时前端区块不渲染、POST 返回 403——既有 Review / Target / Quality Gate 路径零影响。
# PAPERTEAM_TARGET_EVIDENCE_AUDIT_ENABLED=false

# ---- Citation 核验（M3.1） ----
# metadata 层开关（CrossRef/OpenAlex/arXiv；关闭时仅静态核验，可选，默认 true）
# CITATION_METADATA_ENABLED=true
# 最多核验的 bib 条目数（rate-limit friendly，可选，默认 20）
# CITATION_MAX_METADATA_LOOKUPS=20
# 单请求超时（毫秒，可选，默认 8000）
# CITATION_METADATA_TIMEOUT_MS=8000
# CrossRef 礼仪联系邮箱（可选，不填写任何密钥）
# CITATION_CONTACT_EMAIL=paperteam@example.com

# ---- PDF 解析（已有论文导入 / Review 输入） ----
# 解析依赖 Python 3 + pymupdf（pip install pymupdf）。缺省按 python / python3 / py -3 顺序自动探测；
# 解释器不在 PATH 时用绝对路径指定（可运行 npm run doctor 自检）
# PAPERTEAM_PDF_PYTHON=C:\Python311\python.exe
# 结构化解析（docling：版面 / 表格 / 图片抽取）用解释器（可选；未安装时
# PDF 自动降级 pymupdf 文本层，行为不变）。Docker 用 backend-docling 镜像时
# 已内置并指向独立 venv；裸机自装后指向对应解释器
# PAPERTEAM_DOCLING_PYTHON=/opt/paperteam-docling-venv/bin/python
# docling 解析子进程并发上限（可选，默认 1 = 逐个执行；服务器资源充足可调 2）
# PAPERTEAM_DOCLING_CONCURRENCY=1
# docling 首次解析从 HuggingFace 下载模型（数百 MB，落缓存后不再联网）。
# 国内网络可走镜像；Docker backend-docling 镜像的缓存已持久化到 /data/hf-cache
# HF_ENDPOINT=https://hf-mirror.com

# ---- Research Discovery / Search（M6.3；全部可选——零配置时学术检索照常可用） ----
# 独立 SearXNG 服务地址（Web Search）。未配置 = Web Search 不可用，不影响启动与
# 学术检索。部署方式：docker compose --profile research up -d（compose 内地址为
# http://searxng:8080；本机裸跑 SearXNG 常为 http://127.0.0.1:8080）。
# SearXNG 必须在 settings.yml 开启 search.formats 的 json（模板已开，见
# docker/searxng/settings.yml），否则 /search 返回 403。
# PAPERTEAM_SEARXNG_URL=http://searxng:8080
# OpenAlex 礼貌池标识（可选；不设则回退 CITATION_CONTACT_EMAIL；都没有也能用）
# PAPERTEAM_OPENALEX_MAILTO=paperteam@example.com
# Semantic Scholar API Key（可选；无 key 匿名调用——受限时如实降级 rate_limited）
# PAPERTEAM_SEMANTIC_SCHOLAR_API_KEY=
# AMiner API Key（可选；不设 = AMiner provider 不注册，其余源不受影响）
# PAPERTEAM_AMINER_API_KEY=
# 禁用指定 search provider（逗号分隔：openalex / semantic-scholar / arxiv / aminer / searxng）
# PAPERTEAM_SEARCH_DISABLED_PROVIDERS=
# 单 provider HTTP 超时（毫秒，可选，默认 10000；1000-60000）
# PAPERTEAM_SEARCH_TIMEOUT_MS=10000

# ---- 学术网络代理（M13.8；可选） ----
# 仅作用于学术检索（OpenAlex / arXiv / Semantic Scholar / AMiner / SearXNG 公网地址）、
# 文献元数据核验（Crossref / OpenAlex / S2 / arXiv / Unpaywall / GitHub 软件引用）与合法
# OA 全文 PDF 下载；不影响模型 API 请求、本机 PaperTeam API、docling、Git。
# 形态：http://host:port 或 socks5://host:port（必须带端口；不接受账号密码）。
# 优先级：本变量 > 设置 → 网络设置 保存的 <PAPERTEAM_RUNTIME_ROOT>/settings/network.json > 直连。
# 回环 / 私网 / 单标签主机名（如 compose 服务名 searxng）始终直连。详见 docs/network-settings.md
# PAPERTEAM_RESEARCH_PROXY_URL=http://127.0.0.1:7890

# ---- 存储 ----
# 用户论文项目工作区根目录（运行时数据，不入库）。注意：变量名无 PAPERTEAM_
# 前缀（历史事实源，双 runtime 沿用；与 PAPERTEAM_RUNTIME_ROOT 共同构成
# PaperTeam 的两个数据根，见 docs/deployment/dual-runtime.md）
PROJECTS_ROOT=./projects

# ---- Docker 部署（compose.yml 专用） ----
# web 对外端口（默认 8080；可带绑定地址前缀，如 127.0.0.1:8080 = 只发布回环，
# 远程访问走 SSH 隧道，见 docs/deployment/linux-server.md §6）
# PAPERTEAM_WEB_PORT=8080
# backend 镜像（默认基镜像；启用 docling 结构化解析时先构建 backend-docling
# 目标再切换，见 compose.yml 头部说明）
# PAPERTEAM_BACKEND_IMAGE=paperteam-backend-docling:local
# backend 构建目标（默认 backend）。设 docling 镜像时必须同步设 backend-docling，
# 否则 `docker compose build` 会按 base 目标构建并打上 docling 镜像名，静默覆盖
# PAPERTEAM_BACKEND_TARGET=backend-docling

# ---- LaTeX ----
# 单次 LaTeX 编译超时（毫秒，可选，默认 120000）
# LATEX_COMPILE_TIMEOUT_MS=120000

# ---- M10.2 Vision（测试专用；正式环境不设置） ----
# E2E 假模型 seam：PAPERTEAM_TEST_VISION=scripted 时图片分析用确定性假模型
# （scripts/m10-2-e2e.mjs 自动设置；不访问任何真实模型）
# PAPERTEAM_TEST_VISION=scripted
# Live Vision smoke 门控（backend/test/vision/visionLive.smoke.test.ts）：
# PAPERTEAM_VISION_LIVE=1 才运行；模型规格可用 PAPERTEAM_VISION_LIVE_MODEL
# 覆盖（缺省 zai-coding-cn/glm-4.6v——目录声明 image input 的 Vision 模型）
# PAPERTEAM_VISION_LIVE=1
# PAPERTEAM_VISION_LIVE_MODEL=zai-coding-cn/glm-4.6v
