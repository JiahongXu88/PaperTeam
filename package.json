{
  "name": "paperteam",
  "version": "0.1.0",
  "private": true,
  "description": "PaperTeam — AI Multi-Agent Academic Research & Paper Workbench（根开发入口：Runtime Bootstrap + Backend）",
  "type": "module",
  "engines": {
    "node": ">=22.22.3 <23 || >=24.15.0 <25 || >=25.9.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "install:all": "npm install && npm --prefix backend install",
    "build": "npm --prefix backend run build",
    "typecheck": "npm --prefix backend run typecheck",
    "test": "npm --prefix backend test"
  },
  "devDependencies": {
    "openclaw": "2026.8.2"
  }
}
