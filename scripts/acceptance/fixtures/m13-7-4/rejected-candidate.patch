diff --git a/backend/test/manuscript/chapterResponsibility.test.ts b/backend/test/manuscript/chapterResponsibility.test.ts
new file mode 100644
index 0000000..41863ab
--- /dev/null
+++ b/backend/test/manuscript/chapterResponsibility.test.ts
@@ -0,0 +1,93 @@
+import { mkdtemp, readFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { describe, expect, it } from "vitest";
+import { ManuscriptService, validateOutline, type Outline } from "../../src/manuscript/ManuscriptService.js";
+import { ProjectStore } from "../../src/project/ProjectStore.js";
+import { renderChapterResponsibility, RESPONSIBILITY_PROMPT_MAX_CHARS } from "../../src/manuscript/chapterResponsibility.js";
+import { buildSectionPrompt, buildSurveySectionPrompt, WriterService } from "../../src/writer/WriterService.js";
+import type { AgentRuntime } from "../../src/runtime/types.js";
+
+const sample = (): Outline => ({
+  title: "Study", sections: ["intro", "method", "comparison", "conclusion"].map(id => ({ id, title: id, file: `${id}.tex` })),
+  responsibility: { version: 1,
+    concepts: [{ term: "Mechanism (M)", owner: "method", reminder: "brief" }],
+    chapters: ["intro", "method", "comparison", "conclusion"].map(sectionId => ({ sectionId, goal: `${sectionId} goal`, questions: [`${sectionId} question`], dependsOn: sectionId === "comparison" ? ["method"] : [], evidenceIds: [] })),
+  },
+});
+
+describe("chapter responsibility contract", () => {
+  it("validates ownership, chapter coverage, canonical IDs and bounded schema", () => {
+    expect(validateOutline(sample())).toEqual([]);
+    for (const mutate of [
+      (o: Outline) => o.responsibility!.concepts.push({ term: " mechanism (m) ", owner: "intro", reminder: "reference" }),
+      (o: Outline) => { o.responsibility!.concepts[0]!.owner = "missing"; },
+      (o: Outline) => o.responsibility!.chapters.pop(),
+      (o: Outline) => { o.responsibility!.chapters[0]!.evidenceIds = ["made-up"]; },
+      (o: Outline) => { o.responsibility!.chapters[0]!.goal = "x".repeat(121); },
+      (o: Outline) => { o.responsibility!.chapters[0]!.dependsOn = ["intro"]; },
+      (o: Outline) => { o.responsibility!.chapters[0]!.questions = []; },
+    ]) {
+      const o = sample(); mutate(o); expect(validateOutline(o).join(";")).toContain("responsibility");
+    }
+    const long = sample();
+    long.responsibility!.concepts = Array.from({ length: 16 }, (_, i) => ({ term: `${i}` + "x".repeat(58), owner: "method", reminder: "brief" }));
+    long.sections = Array.from({ length: 20 }, (_, i) => ({ id: `section-${i}`, title: `Section ${i}`, file: `section-${i}.tex` }));
+    long.responsibility!.concepts.forEach(c => { c.owner = "section-0"; });
+    long.responsibility!.chapters = long.sections.map(s => ({ sectionId: s.id, goal: "goal", questions: ["question"], dependsOn: [], evidenceIds: [] }));
+    long.responsibility!.chapters.forEach(c => { c.goal = "x".repeat(120); c.questions = ["q".repeat(100), "z".repeat(100), "y".repeat(100)]; });
+    expect(validateOutline(long).length).toBeGreaterThan(0);
+    const malformed = sample(); malformed.responsibility = null as never;
+    expect(validateOutline(malformed).length).toBeGreaterThan(0);
+  });
+
+  it("survives save/restart and fresh prompts with no prior session or manuscript", async () => {
+    const projects = new ProjectStore({ root: await mkdtemp(join(tmpdir(), "responsibility-")) });
+    const project = await projects.create("test");
+    const before = sample();
+    await new ManuscriptService(projects).saveOutline(project.id, before);
+    const after = await new ManuscriptService(projects).loadOutline(project.id);
+    expect(after).toEqual(before);
+    expect(JSON.parse(await readFile(join(projects.manuscriptDir(project.id), "outline.json"), "utf8"))).toEqual(before);
+    const prompt = buildSectionPrompt({ outline: after!, section: after!.sections[2]!, evidence: [], bibliography: [] });
+    expect(prompt).toContain("comparison question");
+    expect(prompt).not.toContain("method question");
+    expect(prompt).toContain("Mechanism (M)→method");
+    expect(renderChapterResponsibility(after!, "comparison").join("\n").length).toBeLessThanOrEqual(RESPONSIBILITY_PROMPT_MAX_CHARS);
+    expect(after).toEqual(before);
+  });
+
+  it("keeps legacy outlines unchanged and protects necessary academic content", () => {
+    const o = sample(); delete o.responsibility;
+    expect(validateOutline(o)).toEqual([]);
+    expect(renderChapterResponsibility(o, "method")).toEqual([]);
+    const text = renderChapterResponsibility(sample(), "method").join("\n");
+    expect(text).toContain("允许为理解当前论点简短回顾定义");
+    expect(text).toContain("不得为去重删除合法公式、数值、引用、负结果或科学限制");
+  });
+
+  it("both actual writeSection routes receive the contract after session replacement", async () => {
+    const calls: string[] = [];
+    const runtime = { runAgent: async (input: { task: string }) => { calls.push(input.task); return { status: "completed", taskId: "test", output: "\\section{test}\nScoped content." }; } } as unknown as AgentRuntime;
+    const outline = sample();
+    const survey = { sectionId: "comparison", title: "comparison", keyPoints: [], sectionContext: "core", speculativeAllowed: false, synthesis: [], literature: [], evidence: [], evidenceBackedKeys: [], allowedCitationKeys: [], danglingSynthesisRefs: [], danglingLiteratureRefs: [], warnings: [] } as unknown as Parameters<typeof buildSurveySectionPrompt>[0]["survey"];
+    for (const s of [undefined, survey]) {
+      await new WriterService({ runtime, agentId: "writer" }).writeSection({ projectId: "p-test", outline, section: outline.sections[2]!, evidence: [], bibliography: [], ...(s ? { survey: s } : {}) });
+    }
+    expect(calls.every(p => p.includes("comparison question"))).toBe(true);
+    expect(calls[0]).not.toEqual(calls[1]);
+  });
+
+  it("planner parses contracts, rejects fabricated evidence, and requires contracts in new workflows", async () => {
+    let output = sample();
+    const runtime = { runAgent: async () => ({ status: "completed", taskId: "test", output: JSON.stringify(output) }) } as unknown as AgentRuntime;
+    const writer = new WriterService({ runtime, agentId: "writer" });
+    const args = { projectId: "p-test", researchDigest: { domainOverview: "test", researchGaps: [], potentialContributions: [] }, evidence: [], bibliography: [], requireResponsibility: true };
+    expect((await writer.planOutline(args)).responsibility).toEqual(output.responsibility);
+    output.responsibility!.chapters[0]!.evidenceIds = ["E999"];
+    await expect(writer.planOutline(args)).rejects.toThrow("evidenceIds");
+    output = sample(); delete output.responsibility;
+    await expect(writer.planOutline(args)).rejects.toThrow("responsibility is required");
+    expect((await writer.planOutline({ ...args, requireResponsibility: false })).responsibility).toBeUndefined();
+  });
+});
