index 0000000..caf7c86
--- /dev/null
+++ b/backend/test/writer/crossSectionContext.test.ts
@@ -0,0 +1,46 @@
+import { describe, expect, it } from "vitest";
+import { buildSectionPrompt, renderCrossSectionContext } from "../../src/writer/WriterService.js";
+import type { Outline } from "../../src/manuscript/ManuscriptService.js";
+
+const outline: Outline = {
+  title: "公开文献综述",
+  sections: [
+    { id: "intro", title: "引言", file: "intro.tex", keyPoints: ["定义检索增强生成（RAG）"] },
+    { id: "scope", title: "范围", file: "scope.tex", keyPoints: ["仅摘要证据，无独立复现"] },
+  ],
+};
+
+describe("explicit cross-section context", () => {
+  it("a fresh prompt retains prior terminology and scope without promoting prior claims to Evidence", () => {
+    const prompt = buildSectionPrompt({
+      outline, section: outline.sections[1]!, evidence: [], bibliography: [],
+      previousSections: [{ id: "intro", title: "引言", latex: "检索增强生成（RAG）结合不同记忆。本文仅采用摘要，未独立复现。" }],
+    });
+    expect(prompt).toContain("检索增强生成（RAG）结合不同记忆");
+    expect(prompt).toContain("仅摘要证据，无独立复现");
+    expect(prompt).toContain("不是事实证据");
+    expect(prompt).toContain("不能以保持一致为由继承");
+    expect(prompt).toContain("无已核验");
+  });
+
+  it("bounds long history, retains the immediate ending and never edits original manuscript", () => {
+    const latex = "定义保持。".repeat(2000) + "尚缺跨域评测，不能外推。";
+    const history = Array.from({ length: 12 }, (_, i) => ({ id: `s${i}`, title: `Section ${i}`, latex }));
+    const before = structuredClone(history);
+    const rendered = renderCrossSectionContext(outline, outline.sections[1]!, history).join("\n");
+    expect(rendered.length).toBeLessThan(11000);
+    expect(rendered).toContain("上一节结尾");
+    expect(rendered).toContain("尚缺跨域评测，不能外推。");
+    expect(rendered).toContain("后部省略");
+    expect(history).toEqual(before);
+  });
+
+  it("does not echo the target as a prior chapter or require removing necessary repetition", () => {
+    const rendered = renderCrossSectionContext(outline, outline.sections[1]!, [
+      { id: "scope", title: "范围", latex: "TARGET_MUST_NOT_BE_HISTORY" },
+    ]).join("\n");
+    expect(rendered).not.toContain("TARGET_MUST_NOT_BE_HISTORY");
+    expect(rendered).toContain("不得为去重删除真实数值、公式、负结果或科学限制");
+    expect(rendered).toContain("新的事实论断处仍须清晰标注");
+  });
+});
