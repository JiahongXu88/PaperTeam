diff --git a/backend/src/manuscript/chapterResponsibility.ts b/backend/src/manuscript/chapterResponsibility.ts
new file mode 100644
index 0000000..9c22435
--- /dev/null
+++ b/backend/src/manuscript/chapterResponsibility.ts
@@ -0,0 +1,84 @@
+import type { Outline } from "./ManuscriptService.js";
+
+/** Organization only. Never a source of scientific facts or citation permission. */
+export interface ChapterResponsibilityContract {
+  version: 1;
+  concepts: Array<{ term: string; owner: string; reminder: "brief" | "reference" }>;
+  chapters: Array<{
+    sectionId: string;
+    goal: string;
+    questions: string[];
+    dependsOn: string[];
+    evidenceIds: string[];
+  }>;
+}
+
+export const RESPONSIBILITY_MAX_CHARS = 6000;
+export const RESPONSIBILITY_PROMPT_MAX_CHARS = 3000;
+
+export function validateChapterResponsibility(outline: Outline): string[] {
+  const raw: unknown = outline.responsibility;
+  if (raw === undefined) return []; // Legacy projects keep their existing behavior.
+  const errors: string[] = [];
+  const object = (v: unknown): v is Record<string, unknown> => typeof v === "object" && v !== null && !Array.isArray(v);
+  const text = (v: unknown, max: number): v is string => typeof v === "string" && v.trim().length > 0 && v.length <= max;
+  const list = (v: unknown, max: number, length: number): v is string[] => Array.isArray(v) && v.length <= max && v.every(x => text(x, length)) && new Set(v).size === v.length;
+  if (!object(raw) || raw.version !== 1 || !Array.isArray(raw.concepts) || !Array.isArray(raw.chapters)) return ["responsibility: expected version=1, concepts[], chapters[]"];
+  if (JSON.stringify(raw).length > RESPONSIBILITY_MAX_CHARS) errors.push("responsibility: exceeds 6000 characters");
+  if (raw.concepts.length > 16) errors.push("responsibility: at most 16 concepts");
+  const ids = new Set(outline.sections.map(s => s.id));
+  const terms = new Set<string>();
+  for (const c of raw.concepts) {
+    if (!object(c) || !text(c.term, 60) || !text(c.owner, 64) || !ids.has(c.owner) || !["brief", "reference"].includes(String(c.reminder))) {
+      errors.push("responsibility: invalid concept or owner"); continue;
+    }
+    const key = c.term.normalize("NFKC").trim().toLocaleLowerCase();
+    if (terms.has(key)) errors.push(`responsibility: duplicate concept owner: ${c.term}`);
+    terms.add(key);
+  }
+  const seen = new Set<string>();
+  for (const c of raw.chapters) {
+    if (!object(c) || !text(c.sectionId, 64) || !ids.has(c.sectionId) || !text(c.goal, 120) || !list(c.questions, 3, 100) || c.questions.length === 0 || !list(c.dependsOn, 4, 64) || !list(c.evidenceIds, 6, 40)) {
+      errors.push("responsibility: invalid chapter"); continue;
+    }
+    if (seen.has(c.sectionId)) errors.push(`responsibility: duplicate chapter: ${c.sectionId}`);
+    seen.add(c.sectionId);
+    if (c.dependsOn.some(id => !ids.has(id) || id === c.sectionId)) errors.push(`responsibility: invalid dependency: ${c.sectionId}`);
+    if (c.evidenceIds.some(id => !/^E\d+$/.test(id))) errors.push(`responsibility: invalid canonical evidence ID: ${c.sectionId}`);
+  }
+  if (seen.size !== ids.size || raw.chapters.length !== ids.size) errors.push("responsibility: every section must have exactly one chapter");
+  if (errors.length === 0) {
+    for (const section of outline.sections) {
+      if (renderChapterResponsibility(outline, section.id).join("\n").length > RESPONSIBILITY_PROMPT_MAX_CHARS) {
+        errors.push("responsibility: projection exceeds 3000 characters"); break;
+      }
+    }
+  }
+  return errors;
+}
+
+/** No preceding manuscript text and no session state: identical after restart/rotation. */
+export function renderChapterResponsibility(outline: Outline, sectionId: string): string[] {
+  const contract = outline.responsibility;
+  if (!contract) return [];
+  const chapter = contract.chapters.find(c => c.sectionId === sectionId);
+  if (!chapter) return [];
+  return [
+    "===== 章节职责（组织约定，不是事实证据）=====",
+    `术语→完整展开章节：${contract.concepts.map(c => `${c.term}→${c.owner}（其他章${c.reminder === "brief" ? "简短回顾" : "回指"}）`).join("；")}`,
+    `本章目标：${chapter.goal}。完整展开：${contract.concepts.filter(c => c.owner === sectionId).map(c => c.term).join("、") || "无；本章组织、综合或总结，不完整介绍已有机制"}`,
+    `当前章必须回答：${chapter.questions.join("；")}。承接：${chapter.dependsOn.join(",") || "无"}。优先证据：${chapter.evidenceIds.join(",") || "沿用本节合法 refs / Evidence"}`,
+    "非 owner 概念至多用一句短提示承接，不再列组成、操作顺序或梯度路径；比较章直接分析比较维度和关系，回指机制章，不重写其定义段。摘要/引言/结论可概括研究问题与结论，不必重述完整技术过程。统一术语与定义范围；只用 quote 明示机制，不凭术语常识补结构细节。职责不是事实或引用许可，优先 ID 未在视图时先 evidence_query；Survey 仍受本节 refs 约束。",
+    "摘要、引言、结论可必要概括；允许为理解当前论点简短回顾定义。不得为去重删除合法公式、数值、引用、负结果或科学限制；限制集中论述，相关结论保留必要限定。贡献/实验仅写已完成且获授权的内容，未来计划归展望；职责与内部执行状态不进入正文。",
+  ];
+}
+
+export function responsibilityPlanningLines(survey: boolean): string[] {
+  return [
+    '同时输出 responsibility: {"version":1,"concepts":[{"term":"统一术语（可含缩写）","owner":"section id","reminder":"brief"}],"chapters":[{"sectionId":"section id","goal":"本章独有论述目标","questions":["必须回答的问题"],"dependsOn":[],"evidenceIds":[]}]}。',
+    "写作前分配主要定义与机制的完整展开章节，每个术语只有一个 owner（并非只能出现一次）；其他章按 brief 简短回顾或 reference 回指。比较章综合分析，不重新完整介绍方法。每节恰好一个 chapter，逻辑关系用 dependsOn，目标≤120字符，问题1–3个各≤100字符，依赖≤4个；概念≤16个，term≤60字符。整个 responsibility≤6000字符，保持简洁。统一术语拼写和定义范围，不创建新定义、事实、公式、实验结果或来源。",
+    survey
+      ? "综述职责从已有 synthesis 组织方法体系/比较/空缺/展望；不套原创方法与实验模板。evidenceIds 留空，重点文献与证据沿用每节合法 synthesisRefs/literatureRefs 映射，不自行编造 ID。"
+      : "原创论文分别安排研究问题、实际方法、授权实验、贡献、限制与展望；不把潜在贡献当已完成结果。evidenceIds 仅可逐字复制下方正式 Evidence 的 canonical ID，每章≤6个，可为空；不创造 ID。",
+  ];
+}
