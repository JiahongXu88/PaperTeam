{
  "name": "paperteam-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "PaperTeam React Web Workbench（M4：React 19 + TypeScript + Vite）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
