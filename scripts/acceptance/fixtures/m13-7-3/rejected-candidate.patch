+/** Explicit manuscript context survives disposable runtime session rotation. */
+export interface WrittenSectionContext {
+  id: string;
+  title: string;
+  latex: string;
+}
+
+/** Organizational context, never verified Evidence. Excerpts end at sentence boundaries. */
+export function renderCrossSectionContext(
+  outline: Outline,
+  section: OutlineSection,
+  previousSections: WrittenSectionContext[] = [],
+): string[] {
+  const lines = [
+    "===== 跨章节论述分工（组织上下文，不是事实证据）=====",
+    ...outline.sections.slice(0, 12).map((item) =>
+      `- ${item.id === section.id ? "当前节" : "其他节"} ${item.title}（${item.id}）：${(item.keyPoints ?? []).slice(0, 6).join("；").slice(0, 600)}`),
+    "本节推进自己的论点；前节已解释的定义与机制仅作必要承接，不重新完整介绍。沿用前文同一概念的名称与缩写；若前文存在事实错误，不能以保持一致为由继承，应以当前 Evidence 为准。",
+    "同一来源可在不同章节支持不同论点；同一段落连续转述同一来源时合理合并引用，但来源归因变化处和新的事实论断处仍须清晰标注，不跨段省略必要引用。",
+    "引言说明范围与组织贡献，核心章节展开依据，局限性集中说明范围与未完成评测，结论综合回答问题。必要定义提醒、摘要与结论呼应、结论旁的适用限定应保留；不得为去重删除真实数值、公式、负结果或科学限制。",
+  ];
+  const prior = previousSections.filter(item => item.id !== section.id).slice(0, 12);
+  if (prior.length === 0) return lines;
+  const excerpt = (text: string, budget: number, tail = false) => {
+    if (text.length <= budget) return text;
+    const fragment = tail ? text.slice(-budget) : text.slice(0, budget);
+    const boundaries = /[。！？；\n]/g;
+    if (tail) {
+      const first = boundaries.exec(fragment);
+      return first ? `【前部省略】${fragment.slice(first.index + 1)}` : "【片段无完整句，省略】";
+    }
+    let last = -1;
+    for (const match of fragment.matchAll(boundaries)) last = match.index! + 1;
+    return last > 0 ? `${fragment.slice(0, last)}【后部省略】` : "【片段无完整句，省略】";
+  };
+  lines.push("已写章节原文摘录（有界视图；省略不表示原稿缺失，不得据此推断事实或允许引用）：");
+  for (const [index, item] of prior.entries()) {
+    lines.push(`[${item.id}] ${item.title}`, excerpt(item.latex, index === prior.length - 1 ? 2400 : index === 0 ? 1200 : 480));
+  }
+  lines.push("上一节结尾（据此自然承接；不强加因果或转折关系）：", excerpt(prior.at(-1)!.latex, 600, true));
+  return lines;
+}
