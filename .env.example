# ============================================================
# PaperTeam 环境变量示例
#
# 使用方法：复制本文件为 .env，填入真实值。
# .env 已被 .gitignore 忽略，严禁将真实 Key 提交到仓库。
# ============================================================

# ---- 服务 ----
# PaperTeam Backend 监听端口
PAPERTEAM_PORT=3000
# 运行环境: development | production
NODE_ENV=development

# ---- 数据库 ----
# 第一版使用 SQLite，后续可切换 PostgreSQL
DATABASE_PATH=./data/paperteam.sqlite
# DATABASE_URL=postgresql://user:password@localhost:5432/paperteam

# ---- Agent Runtime（OpenClaw） ----
# OpenClaw Gateway 地址（服务器内部服务，不对外暴露）。
# 使用 `npm run dev`（Runtime Bootstrap）时无需手动设置：Backend 会由
# Bootstrap 注入 PaperTeam 独立 Gateway（默认 http://127.0.0.1:18790）。
# PAPERTEAM_AGENT_RUNTIME=pi 时本项不必设置（Pi 为 in-process Runtime）。
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_API_KEY=replace-with-your-gateway-key
# Gateway 健康检查超时（毫秒，可选，默认 5000）
# OPENCLAW_GATEWAY_HEALTH_TIMEOUT_MS=5000
# WebSocket 连接与单次 RPC 超时（毫秒，可选，默认 15000）
# OPENCLAW_GATEWAY_RPC_TIMEOUT_MS=15000
# 单次 runAgent 整体超时（毫秒，可选，默认 300000）
# OPENCLAW_AGENT_RUN_TIMEOUT_MS=300000
# 各业务 Agent 对应的 OpenClaw agent id（可选，默认全部 main：业务角色靠
# prompt + contextScope 隔离，无需独立注册 agent；见 docs/DECISIONS.md D-0018）
# OPENCLAW_WRITER_AGENT_ID=main
# OPENCLAW_RESEARCHER_AGENT_ID=main
# OPENCLAW_REVIEWER_AGENT_ID=main
# OPENCLAW_CITATION_AGENT_ID=main

# ---- Runtime Bootstrap（`npm run dev`，M3.5） ----
# PaperTeam 用户级运行时根目录（独立 OpenClaw state/config 所在，默认 ~/.paperteam；
# 与全局 ~/.openclaw 完全隔离，Bootstrap 会拒绝嵌套路径）
# PAPERTEAM_RUNTIME_ROOT=C:\Users\you\.paperteam
# PaperTeam 独立 Gateway 端口（默认 18790，避开全局常用 18789）
# PAPERTEAM_DEV_GATEWAY_PORT=18790
# Backend 端口（默认 3000）
# PAPERTEAM_DEV_BACKEND_PORT=3000
# Gateway 共享 token（缺省首次自动生成并保存在 ~/.paperteam/runtime/runtime.json）
# PAPERTEAM_DEV_GATEWAY_TOKEN=
# 模型凭据（provider API Key）不放在仓库 .env：请写入 PaperTeam 独立
# OpenClaw state 的 .env（默认 ~/.paperteam/runtime/openclaw/.env），
# 例如 ANTHROPIC_API_KEY=... / OPENAI_API_KEY=... / GEMINI_API_KEY=...

# ---- Agent Runtime 选择（M3.7 Feasibility） ----
# openclaw（默认，生产基线）| pi（@earendil-works/pi-coding-agent in-process）
# PAPERTEAM_AGENT_RUNTIME=openclaw
# Pi 模型规格 "provider/model-id"（如 anthropic/claude-opus-4-5）；
# 未设置时 Pi Runtime 健康但 runAgent 结构化失败（model_not_configured）
# PAPERTEAM_PI_MODEL=anthropic/claude-opus-4-5
# Provider API Key（可选；不设置则按 Pi 官方优先级解析：
# <agentDir>/auth.json > 标准环境变量如 ANTHROPIC_API_KEY）
# PAPERTEAM_PI_API_KEY=
# Pi 全局配置目录（可选，默认 <PAPERTEAM_RUNTIME_ROOT>/runtime/pi/agent）
# PAPERTEAM_PI_AGENT_DIR=
# Pi 单次 runAgent 整体超时（毫秒，可选，默认 300000）
# PAPERTEAM_PI_RUN_TIMEOUT_MS=300000

# ---- Workflow（M3） ----
# 单个 Stage 执行超时（毫秒，可选，默认 900000）
# WORKFLOW_STAGE_TIMEOUT_MS=900000
# 单个 Stage 最大尝试次数（可选，默认 2）
# WORKFLOW_STAGE_MAX_ATTEMPTS=2
# 自动修订最大轮数（bounded loop，可选，默认 2；超出进入 HITL）
# WORKFLOW_MAX_REVISION_ROUNDS=2
# Quality Gate 阈值（可选；默认 academic>=80、style<=35）
# QUALITY_ACADEMIC_PASS_SCORE=80
# QUALITY_STYLE_RISK_MAX=35

# ---- Citation 核验（M3.1） ----
# metadata 层开关（CrossRef/OpenAlex/arXiv；关闭时仅静态核验，可选，默认 true）
# CITATION_METADATA_ENABLED=true
# 最多核验的 bib 条目数（rate-limit friendly，可选，默认 20）
# CITATION_MAX_METADATA_LOOKUPS=20
# 单请求超时（毫秒，可选，默认 8000）
# CITATION_METADATA_TIMEOUT_MS=8000
# CrossRef 礼仪联系邮箱（可选，不填写任何密钥）
# CITATION_CONTACT_EMAIL=paperteam@example.com

# ---- 模型 Provider ----
MODEL_PROVIDER=replace-with-provider-name
MODEL_API_BASE=https://api.example.com/v1
MODEL_API_KEY=replace-with-your-api-key
# 默认文本模型（Writer / Reviewer 等）
MODEL_NAME=replace-with-text-model-name
# 视觉模型（Visual Reviewer 使用，需支持视觉输入）
VISION_MODEL_NAME=replace-with-vision-model-name

# ---- 存储 ----
# 用户论文项目工作区根目录（运行时数据，不入库）
PROJECTS_ROOT=./projects
# 上传文件目录
UPLOADS_ROOT=./uploads
# 日志目录
LOGS_ROOT=./logs

# ---- LaTeX ----
# 单次 LaTeX 编译超时（毫秒，可选，默认 120000）
# LATEX_COMPILE_TIMEOUT_MS=120000

# ---- 安全 ----
# 会话签名密钥（随机长字符串）
SESSION_SECRET=replace-with-random-long-string
# 初始管理员密码（首次启动后请立即修改）
ADMIN_INITIAL_PASSWORD=replace-with-strong-password
